<Project>
	<PropertyGroup Label="Package Information Properties">
		<AssemblyTitle>$(MSBuildProjectName)</AssemblyTitle>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<PackageId>$(MSBuildProjectName)</PackageId>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup Label="Build Properties">
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
		<NoWarn>$(NoWarn);ASPDEPR002;CS1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup Label="Code Analysis Properties">
		<CodeAnalysisRuleSet>..\..\build\Code Analysis\Code Analysis Rules.ruleset</CodeAnalysisRuleSet>
		<Features>IOperation</Features>
	</PropertyGroup>

	<ItemGroup Label="Code Analysis Files"
	  Condition=" '$(EnableStyleCopAnalyzers)' == 'true' AND '$(MSBuildProjectExtension)' != '.dcproj' ">
		<AdditionalFiles Include="..\..\build\Code Analysis\StyleCop.json" Link="StyleCop.json" />
		<CodeAnalysisDictionary Include="..\..\build\Code Analysis\CustomDictionary.xml">
			<Link>Properties\CustomDictionary.xml</Link>
		</CodeAnalysisDictionary>
	</ItemGroup>

	<PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.dcproj'">
		<DockerDesktopInstalled Condition="Exists('$(ProgramFiles)\Docker\Docker\Docker Desktop.exe')">true</DockerDesktopInstalled>
		<DockerDesktopInstalled Condition=" '$(DockerDesktopInstalled)' == '' ">false</DockerDesktopInstalled>
		<BuildProject Condition=" '$(DockerDesktopInstalled)' == 'true' ">true</BuildProject>
		<BuildProject Condition=" '$(DockerDesktopInstalled)' == 'false' ">false</BuildProject>
	</PropertyGroup>
</Project>
