    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.21.0-rc.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <!-- MySQL providers -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="11.0.0-preview" />
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
