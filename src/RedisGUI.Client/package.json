{
  "name": "redisgui.client",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "build": "ng build",
    "prestart": "node aspnetcore-https.js",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=localhost --open",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=localhost --open",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@microsoft/signalr": "^10.0.11",
    "@monaco-editor/loader": "^1.7.0",
    "@ngrx/signals": "^22.0.1",
    "monaco-editor": "^0.57.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@types/jasmine": "~5.1.15",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
