{
	"Database": {
		"IsInMemory": false,
		"ConnectionStringMSQL": "Data Source=127.0.0.1; Initial Catalog=redis-gui; User Id=sa; Password=YOUR_PASSWORD_HERE; TrustServerCertificate=True;",
		"ConnectionString": "server=localhost;database=redis-gui;user=admin;password=YOUR_PASSWORD_HERE;"
	},
	"Cache": {
		"Duration": "00:05:00",
		"CachedTables": [
			"AnonymousRedisConnection",
			"RedisConnectionWithCredentials"
		]
	},
	"Cryptography": {
		"SecurityKey": "GENERATE_BASE64_KEY_HERE"
	},
	"JwtSettings": {
		"SecretKey": "GENERATE_SECURE_JWT_SECRET_HERE_MIN_32_CHARS",
		"Issuer": "RedisGUI",
		"Audience": "RedisGUI.Client",
		"ExpirationMinutes": 60
	},
	"MetricsCollector": {
		"PoolingIntervalInSec": 5
	},
	"Redis": {
		"ConnectionPool": {
			"MaxConnections": 50,
			"ConnectionTimeout": "00:00:15",
			"SyncTimeout": "00:00:10"
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"Microsoft.AspNetCore.SignalR": "Debug",
			"Microsoft.AspNetCore.Http.Connections": "Debug"
		}
	},
	"AllowedHosts": "*"
}
