{
	"Database": {
		"IsInMemory": false,
		"ConnectionStringMSQL": "",
		"ConnectionString": ""
	},
	"Cache": {
		"Duration": "00:05:00",
		"CachedTables": [
			"AnonymousRedisConnection",
			"RedisConnectionWithCredentials"
		]
	},
	"Cryptography": {
		"SecurityKey": ""
	},
	"JwtSettings": {
		"SecretKey": "",
		"Issuer": "RedisGUI",
		"Audience": "RedisGUI.Client",
		"ExpirationMinutes": 60
	},
	"MetricsCollector": {
		"PoolingIntervalInSec": 5
	},
	"Redis": {
		"Mock": {
			"Enabled": false,
			"SeedDummyData": true,
			"DummyDataKeyCount": 100,
			"EnableTtlExpiration": true
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"Microsoft.AspNetCore.SignalR": "Debug",
			"Microsoft.AspNetCore.Http.Connections": "Debug"
		}
	},
	"AllowedHosts": "*"
}
